# PulseSocial Environment Configuration Template
# Copy this file to .env.local and populate the secrets.
# DO NOT COMMIT ACTUAL SECRETS TO VERSION CONTROL.

# -------------------------------------------------------------
# SUPABASE DATABASE & AUTHENTICATION
# -------------------------------------------------------------
# Public variables exposed to client-side code
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Private server-side key with administrative bypass (NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# -------------------------------------------------------------
# APPLICATION SECURITY & ENCRYPTION
# -------------------------------------------------------------
# 32-byte (64 hex characters) key for AES-256-GCM token encryption at rest
# Generate using: openssl rand -hex 32
OAUTH_ENCRYPTION_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff

# Secret key for session signing and HMAC validation
# Generate using: openssl rand -hex 32
SESSION_SECRET=your-random-session-secret-here

# Super Admin email allowlist (comma-separated)
ADMIN_EMAILS=admin@pulsesocial.ai,founder@pulsesocial.ai

# -------------------------------------------------------------
# AI SERVICES
# -------------------------------------------------------------
# Google Gemini API key (server-side only)
GEMINI_API_KEY=your-gemini-api-key-here

# -------------------------------------------------------------
# BILLING & PAYMENTS
# -------------------------------------------------------------
# Paystack secret key for subscriptions and Mobile Money verification (sk_live_... or sk_test_...)
PAYSTACK_SECRET_KEY=sk_test_your-paystack-secret-key

# -------------------------------------------------------------
# SOCIAL PLATFORMS & COMPOSIO OAUTH
# -------------------------------------------------------------
# Composio Connect MCP API Key for unified social management
COMPOSIO_API_KEY=your-composio-api-key

# Direct Developer App IDs (Optional if using Composio)
META_APP_ID=
FACEBOOK_CLIENT_ID=
LINKEDIN_CLIENT_ID=
TWITTER_CLIENT_ID=
TIKTOK_CLIENT_KEY=
PINTEREST_APP_ID=
GOOGLE_CLIENT_ID=
